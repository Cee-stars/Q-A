{
  "name": "qa-drill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:contrast && npm run test:logic && npm run test:smoke",
    "test:logic": "esbuild test/logic.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/logic.mjs --log-level=warning && node node_modules/.tmp/logic.mjs",
    "test:smoke": "npm run build && node test/smoke.mjs",
    "test:contrast": "node test/contrast.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
